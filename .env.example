# AgriResolve AI - Environment Configuration Example
# Copy this file to .env and populate your actual credentials.
# NEVER COMMIT THE ACTUAL .env FILE TO GIT!

# -------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriresolve_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# -------------------------------------------------------------
# 2. Google Cloud Platform APIs
# -------------------------------------------------------------
# Google Maps JavaScript API (for interactive maps in Streamlit)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Routes API (for AO/AAO field distance and routing calculations)
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

# Google Weather API / Open-Meteo fallback
GOOGLE_WEATHER_API_KEY=your_google_weather_api_key_here

# Google Earth Engine (Service Account / User credentials for Sentinel-2 NDVI)
EE_PROJECT_ID=your_gee_project_id_here
EE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
EE_PRIVATE_KEY_PATH=path/to/private-key.json

# -------------------------------------------------------------
# 3. LLM & Embeddings (Ollama local default / Gemini optional)
# -------------------------------------------------------------
# Ollama settings (default local instance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Google Gemini API Key (if approved/used for hybrid assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# 4. Application Settings
# -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
RSK_DEFAULT_CODE=KA_MDR_01
